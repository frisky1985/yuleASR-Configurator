{
  "name": "@yuletech/core",
  "version": "0.1.0",
  "description": "Core types, schemas, and validators for yuleASR configurator",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./plugins": {
      "types": "./dist/plugins/index.d.ts",
      "import": "./dist/plugins/index.mjs",
      "require": "./dist/plugins/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.mjs",
      "require": "./dist/schema/index.js"
    },
    "./schema/generated": {
      "types": "./dist/schema/generated/index.d.ts",
      "import": "./dist/schema/generated/index.mjs",
      "require": "./dist/schema/generated/index.js"
    },
    "./schema/load-generated": {
      "types": "./dist/schema/load-generated.d.ts",
      "import": "./dist/schema/load-generated.mjs",
      "require": "./dist/schema/load-generated.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.mjs",
      "require": "./dist/types/index.js"
    },
    "./validator": {
      "types": "./dist/validator/index.d.ts",
      "import": "./dist/validator/index.mjs",
      "require": "./dist/validator/index.js"
    },
    "./generator": {
      "types": "./dist/generator/index.d.ts",
      "import": "./dist/generator/index.mjs",
      "require": "./dist/generator/index.js"
    },
    "./schema-extractor": {
      "types": "./dist/schema-extractor/index.d.ts",
      "import": "./dist/schema-extractor/index.mjs",
      "require": "./dist/schema-extractor/index.js"
    },
    "./validators": {
      "types": "./dist/validators/index.d.ts",
      "import": "./dist/validators/index.mjs",
      "require": "./dist/validators/index.js"
    },
    "./adapters/arxml-parser": {
      "types": "./dist/adapters/arxml-parser.d.ts",
      "import": "./dist/adapters/arxml-parser.mjs",
      "require": "./dist/adapters/arxml-parser.js"
    },
    "./arxml-import": {
      "types": "./dist/arxml-import/index.d.ts",
      "import": "./dist/arxml-import/index.mjs",
      "require": "./dist/arxml-import/index.js"
    },
    "./arxml-export": {
      "types": "./dist/arxml-export/index.d.ts",
      "import": "./dist/arxml-export/index.mjs",
      "require": "./dist/arxml-export/index.js"
    },
    "./conditions": {
      "types": "./dist/conditions/index.d.ts",
      "import": "./dist/conditions/index.mjs",
      "require": "./dist/conditions/index.js"
    }
  },
  "scripts": {
    "build": "tsup && rm -f tsconfig.tsbuildinfo && tsc --emitDeclarationOnly --outDir dist && cp dist/index.d.ts dist/index.d.mts",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@yuletech/plugin-sdk": "workspace:*",
    "ajv": "^8.12.0",
    "ajv-formats": "^3.0.0",
    "fast-xml-parser": "^5.10.0"
  },
  "devDependencies": {
    "@rollup/rollup-darwin-arm64": "^4.62.3",
    "@vitest/coverage-v8": "^4.1.10",
    "tsup": "^8.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "Proprietary"
}
