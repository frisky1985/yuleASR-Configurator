{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuletech.io/schemas/modules/eep.json",
  "title": "Eep Configuration",
  "description": "EEPROM 驱动",
  "type": "object",
  "properties": {
    "CommonPublishedInformation": {
      "description": "CommonPublishedInformation 配置容器",
      "type": "object",
      "properties": {
        "ArReleaseMajorVersion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "description": "ArReleaseMajorVersion 参数"
        },
        "ArReleaseMinorVersion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "description": "ArReleaseMinorVersion 参数"
        },
        "ArReleaseRevisionVersion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "description": "ArReleaseRevisionVersion 参数"
        },
        "ModuleId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "description": "ModuleId 参数"
        },
        "SwMajorVersion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "description": "SwMajorVersion 参数"
        },
        "SwMinorVersion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "description": "SwMinorVersion 参数"
        },
        "SwPatchVersion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "description": "SwPatchVersion 参数"
        },
        "VendorId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "description": "VendorId 参数"
        },
        "VendorApiInfix": {
          "type": "string",
          "maxLength": 255,
          "description": "VendorApiInfix 参数"
        }
      },
      "additionalProperties": true
    },
    "EepConfigSet": {
      "description": "EepConfigSet 配置容器",
      "type": "object",
      "properties": {
        "EepBaseAddress": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "EepBaseAddress 参数"
        },
        "EepSize": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "EepSize 参数"
        },
        "EepPageSize": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "description": "EepPageSize 参数"
        },
        "EepJobCallCycle": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "EepJobCallCycle 参数"
        },
        "EepWriteCycleTime": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "EepWriteCycleTime 参数"
        },
        "EepEraseCycleTime": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "EepEraseCycleTime 参数"
        }
      },
      "additionalProperties": true
    },
    "EepGeneral": {
      "description": "EepGeneral 配置容器",
      "type": "object",
      "properties": {
        "EepDevErrorDetect": {
          "type": "boolean",
          "default": false,
          "description": "EepDevErrorDetect 参数"
        },
        "EepVersionInfoApi": {
          "type": "boolean",
          "default": false,
          "description": "EepVersionInfoApi 参数"
        },
        "EepDeInitApi": {
          "type": "boolean",
          "default": false,
          "description": "EepDeInitApi 参数"
        },
        "EepCancelApi": {
          "type": "boolean",
          "default": false,
          "description": "EepCancelApi 参数"
        },
        "EepGetStatusApi": {
          "type": "boolean",
          "default": false,
          "description": "EepGetStatusApi 参数"
        },
        "EepGetJobResultApi": {
          "type": "boolean",
          "default": false,
          "description": "EepGetJobResultApi 参数"
        },
        "EepMainFunctionPeriod": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "EepMainFunctionPeriod 参数"
        }
      },
      "additionalProperties": true
    },
    "EepPublishedInformation": {
      "description": "EepPublishedInformation 配置容器",
      "type": "object",
      "properties": {
        "EepTotalSize": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "EepTotalSize 参数"
        },
        "EepPageSizeDefault": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "description": "EepPageSizeDefault 参数"
        },
        "EepEraseTime": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "EepEraseTime 参数"
        },
        "EepWriteTime": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "EepWriteTime 参数"
        },
        "EepSpecifiedEraseCycles": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "EepSpecifiedEraseCycles 参数"
        }
      },
      "additionalProperties": true
    },
    "AutosarExt": {
      "description": "AutosarExt 配置容器",
      "type": "object",
      "properties": {
        "EepDisableDemReportErrorStatus": {
          "type": "boolean",
          "default": false,
          "description": "EepDisableDemReportErrorStatus 参数"
        },
        "EepEnableUserModeSupport": {
          "type": "boolean",
          "default": false,
          "description": "EepEnableUserModeSupport 参数"
        }
      },
      "additionalProperties": true
    },
    "EepInitConfiguration": {
      "description": "EepInitConfiguration 配置容器 - Container for runtime configuration parameters of the EEPROM driver.",
      "type": "object",
      "properties": {
        "EepBaseAddress": {
          "description": "EepBaseAddress 参数 - This parameter is the EEPROM device base address.",
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "EepDefaultMode": {
          "description": "EepDefaultMode 参数 - This parameter is the default EEPROM device mode after initialization.",
          "type": "string",
          "enum": ["MEMIF_MODE_FAST", "MEMIF_MODE_SLOW"],
          "default": "MEMIF_MODE_SLOW"
        },
        "EepFastReadBlockSize": {
          "description": "EepFastReadBlockSize 参数 - Number of bytes read within one job processing cycle in fast mode. If the hardware does not support burst mode this parameter shall be set to the same value as EepNormalReadBlockSize.",
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "EepFastWriteBlockSize": {
          "description": "EepFastWriteBlockSize 参数 - Number of bytes written within one job processing cycle in fast mode. If the hardware does not support burst mode this parameter shall be set to the same value as EepNormalWriteBlockSize.",
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "EepJobCallCycle": {
          "description": "EepJobCallCycle 参数 - Call cycle time of the EEPROM driver's main function. Unit: [s]",
          "type": "number",
          "minimum": 0.0
        },
        "EepJobEndNotification": {
          "description": "EepJobEndNotification 参数 - This parameter is a reference to a callback function for positive job result (see EEP045).",
          "type": "string",
          "maxLength": 255
        },
        "EepJobErrorNotification": {
          "description": "EepJobErrorNotification 参数 - This parameter is a reference to a callback function for negative job result (see EEP046).",
          "type": "string",
          "maxLength": 255
        },
        "EepNormalReadBlockSize": {
          "description": "EepNormalReadBlockSize 参数 - Number of bytes read within one job processing cycle in normal mode.",
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "EepNormalWriteBlockSize": {
          "description": "EepNormalWriteBlockSize 参数 - Number of bytes written within one job processing cycle in normal mode.",
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "EepSize": {
          "description": "EepSize 参数 - This parameter is the used size of EEPROM device in bytes.",
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "additionalProperties": true
    },
    "EepDemEventParameterRefs": {
      "description": "EepDemEventParameterRefs 配置容器 - Container for the references to DemEventParameter elements which shall be invoked using the API Dem_SetEventStatus in case the corresponding error occurs. The EventId is taken from the referenced DemEventParameter's DemEventId symbolic value. The standardized errors are provided in this container and can be extended by vendor-specific error references.",
      "type": "object",
      "properties": {
        "EEP_E_COMPARE_FAILED": {
          "type": "string",
          "description": "EEP_E_COMPARE_FAILED 引用 - Reference to the DemEventParameter which shall be issued when the error \"EEPROM compare failed (HW)\" has occurred."
        },
        "EEP_E_ERASE_FAILED": {
          "type": "string",
          "description": "EEP_E_ERASE_FAILED 引用 - Reference to the DemEventParameter which shall be issued when the error \"EEPROM erase failed (HW)\" has occurred."
        },
        "EEP_E_READ_FAILED": {
          "type": "string",
          "description": "EEP_E_READ_FAILED 引用 - Reference to the DemEventParameter which shall be issued when the error \"EEPROM read failed (HW)\" has occurred."
        },
        "EEP_E_WRITE_FAILED": {
          "type": "string",
          "description": "EEP_E_WRITE_FAILED 引用 - Reference to the DemEventParameter which shall be issued when the error \"EEPROM write failed (HW)\" has occurred."
        }
      },
      "additionalProperties": true
    },
    "EepExternalDriver": {
      "description": "EepExternalDriver 配置容器 - This container is present for external EEPROM drivers only. Internal EEPROM drivers do not use the parameter listed in this container, hence its multiplicity is 0 for internal drivers.",
      "type": "object",
      "properties": {
        "EepSpiReference": {
          "type": "string",
          "description": "EepSpiReference 引用 - Reference to SPI sequence (required for external EEPROM drivers)."
        }
      },
      "additionalProperties": true
    }
  },
  "required": ["CommonPublishedInformation", "EepConfigSet", "EepGeneral"],
  "additionalProperties": false,
  "x-layer": "MCAL",
  "x-version": "4.4.0",
  "x-source": "ARXML-Extracted"
}
