{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuletech.io/schemas/modules/compswc.json",
  "title": "Composition SWC Configuration",
  "description": "AUTOSAR CompositionSwComponentType configuration for yuleASR Configurator",
  "type": "object",
  "x-layer": "ASW",
  "properties": {
    "ComponentName": {
      "type": "string",
      "description": "Name of the composition SW component",
      "minLength": 1
    },
    "ComponentDescription": {
      "type": "string",
      "description": "Description of the composition"
    },
    "SubComponents": {
      "type": "array",
      "description": "Sub-component references within the composition",
      "items": {
        "type": "object",
        "properties": {
          "SubComponentName": {
            "type": "string"
          },
          "SubComponentTypeRef": {
            "type": "string"
          }
        }
      }
    },
    "PortInterfaces": {
      "type": "array",
      "description": "Port interface definitions for the composition boundary",
      "items": {
        "type": "object",
        "properties": {
          "PortInterfaceName": {
            "type": "string"
          },
          "PortInterfaceKind": {
            "type": "string",
            "enum": [
              "SenderReceiverInterface",
              "ClientServerInterface",
              "ModeSwitchInterface",
              "ParameterInterface",
              "NvDataInterface"
            ]
          },
          "PortInterfaceDescription": {
            "type": "string"
          }
        }
      }
    },
    "Ports": {
      "type": "array",
      "description": "Composition boundary port prototypes",
      "items": {
        "type": "object",
        "properties": {
          "PortName": {
            "type": "string"
          },
          "PortDirection": {
            "type": "string",
            "enum": [
              "IN",
              "OUT",
              "INOUT"
            ]
          },
          "PortInterfaceRef": {
            "type": "string"
          },
          "PortDescription": {
            "type": "string"
          }
        }
      }
    },
    "AssemblyConnectors": {
      "type": "array",
      "description": "Assembly SW connectors (sub-component to sub-component)",
      "items": {
        "type": "object",
        "properties": {
          "ConnectorName": {
            "type": "string"
          },
          "ConnectorSourceComponent": {
            "type": "string"
          },
          "ConnectorSourcePort": {
            "type": "string"
          },
          "ConnectorTargetComponent": {
            "type": "string"
          },
          "ConnectorTargetPort": {
            "type": "string"
          }
        }
      }
    },
    "DelegationConnectors": {
      "type": "array",
      "description": "Delegation SW connectors (boundary port to sub-component port)",
      "items": {
        "type": "object",
        "properties": {
          "DelegateName": {
            "type": "string"
          },
          "DelegateOuterPort": {
            "type": "string"
          },
          "DelegateInnerComponent": {
            "type": "string"
          },
          "DelegateInnerPort": {
            "type": "string"
          }
        }
      }
    },
    "CommonPublishedInformation": {
      "description": "CommonPublishedInformation 配置容器",
      "type": "object",
      "properties": {
        "ArReleaseMajorVersion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "description": "ArReleaseMajorVersion 参数"
        },
        "ArReleaseMinorVersion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "description": "ArReleaseMinorVersion 参数"
        },
        "ArReleaseRevisionVersion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "description": "ArReleaseRevisionVersion 参数"
        },
        "ModuleId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "description": "ModuleId 参数"
        },
        "SwMajorVersion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "description": "SwMajorVersion 参数"
        },
        "SwMinorVersion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "description": "SwMinorVersion 参数"
        },
        "SwPatchVersion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "description": "SwPatchVersion 参数"
        },
        "VendorId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "description": "VendorId 参数"
        }
      },
      "additionalProperties": true
    }
  },
  "required": [
    "ComponentName"
  ]
}
