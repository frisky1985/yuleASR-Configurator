        "SwMajorVersion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "description": "SwMajorVersion 参数"
        },
        "SwMinorVersion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "description": "SwMinorVersion 参数"
        },
        "SwPatchVersion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "description": "SwPatchVersion 参数"
