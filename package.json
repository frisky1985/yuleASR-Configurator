{
  "name": "yuletech-monorepo",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "yuleASR Configurator - Monorepo for Web and VS Code extension",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "lint:ci": "eslint apps/yuleasr-desktop packages/@yuletech/plugin-sdk && echo '\u2705 lint:ci passed'",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.29.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "builder-util-runtime": "^9.7.0",
      "electron-builder-squirrel-windows": "^26.15.0",
      "fast-jwt": "^6.2.4",
      "fast-xml-parser": "^5.10.1",
      "react-router-dom": "^7.18.0",
      "fast-uri": "^3.1.4",
      "@fastify/static": "^10.1.1",
      "find-my-way": "^9.7.0",
      "brace-expansion": "^5.0.8",
      "sharp": "^0.35.0",
      "linkify-it": "^5.0.2",
      "postcss": "^8.5.18",
      "tar": "^7.5.19",
      "vitest": "^4.1.10",
      "@vitest/ui": "^3.2.6",
      "undici": "^7.28.0",
      "tmp": "^0.2.6",
      "form-data": "^4.0.6",
      "js-yaml": "^4.3.0",
      "qs": "^6.15.2",
      "markdown-it": "^14.2.0",
      "@babel/core": "^7.29.6",
      "dompurify": "^3.4.12",
      "launch-editor": "^2.12.0",
      "esbuild": "^0.28.1"
    }
  }
}
