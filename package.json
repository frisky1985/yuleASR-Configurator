{
  "name": "yuletech-monorepo",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "yuleASR Configurator - Monorepo for Web and VS Code extension",
  "scripts": {
    "build": "pnpm -r build",
    "build:ci": "pnpm --filter '!yuleasr-desktop' -r build",
    "dev": "pnpm -r --parallel dev",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "lint:ci": "eslint apps/yuleasr-desktop packages/@yuletech/plugin-sdk && echo '✅ lint:ci passed'",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.29.1",
    "prettier": "^3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "builder-util-runtime": "^9.7.0",
      "electron-builder-squirrel-windows": "^26.15.0",
      "fast-jwt": "^6.3.4",
      "fast-xml-parser": "^5.10.1",
      "react-router-dom": "^7.18.0",
      "fast-uri": "^3.1.9",
      "@fastify/static": "^10.1.10",
      "find-my-way": "^9.7.0",
      "brace-expansion": "^5.0.12",
      "sharp": "^0.35.5",
      "linkify-it": "^5.0.2",
      "postcss": "^8.5.18",
      "tar": "^7.5.19",
      "vitest": "^4.1.12",
      "@vitest/coverage-v8": "^4.1.12",
      "@vitest/mocker": "^4.1.12",
      "@vitest/ui": "^3.2.6",
      "undici": "^7.30.1",
      "tmp": "^0.2.6",
      "form-data": "^4.0.6",
      "js-yaml": "^4.3.2",
      "qs": "^6.16.1",
      "markdown-it": "^14.3.3",
      "@babel/core": "^7.29.6",
      "dompurify": "^3.4.17",
      "launch-editor": "^2.12.0",
      "esbuild": "0.28.1",
      "vite": "^8.2.4",
      "axios": "^1.20.0",
      "joi": "^18.3.1",
      "follow-redirects": "^1.16.2",
      "fastify": "^5.12.5",
      "zod": "^4.6.6",
      "shell-quote": "^1.11.0",
      "deepmerge-ts": "^8.0.0",
      "@azure/identity": "^4.14.1",
      "ip-address": "^10.7.4",
      "serialize-javascript": "^7.1.3",
      "nanoid@^3.0.0": "3.3.18",
      "source-map-js": "^1.2.2",
      "@xmldom/xmldom@^0.8.0": "0.8.15",
      "@xmldom/xmldom@^0.9.0": "0.9.12",
      "glob@>=9.0.0": "^14.0.2",
      "minimatch@>=7.0.0": "^11.0.1",
      "electron": "^43.8.7"
    },
    "patchedDependencies": {
      "eslint-plugin-import@2.32.0": "patches/eslint-plugin-import@2.32.0.patch"
    }
  },
  "license": "Proprietary"
}
