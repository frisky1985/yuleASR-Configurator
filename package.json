{
  "name": "yuletech-monorepo",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "yuleASR Configurator - Monorepo for Web and VS Code extension",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "lint:ci": "eslint apps/yuleasr-desktop packages/@yuletech/plugin-sdk && echo '✅ lint:ci passed'",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.11.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "prettier": "^3.2.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.0.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "fast-jwt": "^6.2.4",
      "fast-xml-parser": "^5.10.1",
      "react-router-dom": "^7.18.0",
      "fast-uri": "^3.1.4",
      "@fastify/static": "^10.1.1",
      "find-my-way": "^9.7.0",
      "brace-expansion": "^5.0.8",
      "sharp": "^0.35.0",
      "linkify-it": "^5.0.2",
      "postcss": "^8.5.18",
      "tar": "^7.5.19",
      "vitest": "^3.2.6",
      "@vitest/ui": "^3.2.6"
    }
  }
}
